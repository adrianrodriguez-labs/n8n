{
  "name": "05 - Descargas Sospechosas",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wazuh-fim-downloads",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "e1111111-1111-1111-1111-111111111111",
      "name": "Webhook FIM",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "wazuh-fim-downloads"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst path = body.syscheck?.path || body.path || '';\nconst hash = body.syscheck?.sha256_after || body.hash || '';\nconst user = body.data?.win?.eventdata?.subjectUserName || body.user || 'unknown';\nconst hostname = body.agent?.name || body.hostname || 'unknown';\nreturn [{ json: { path, hash, user, hostname, filename: path.split(/[\\\\\\/]/).pop() } }];"
      },
      "id": "e2222222-2222-2222-2222-222222222222",
      "name": "Extraer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.filename }}",
              "rightValue": "\\.(exe|msi|bat|ps1|vbs|zip)$",
              "operator": { "type": "string", "operation": "regex" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e3333333-3333-3333-3333-333333333333",
      "name": "Filtrar Extension",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://www.virustotal.com/api/v3/files/{{ $json.hash }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "e4444444-4444-4444-4444-444444444444",
      "name": "VirusTotal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 220],
      "credentials": {
        "httpHeaderAuth": {
          "id": "virustotal",
          "name": "virustotal"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.data?.attributes?.last_analysis_stats?.malicious || 0 }}",
              "rightValue": 10,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e5555555-5555-5555-5555-555555555555",
      "name": "Sospechoso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1080, 220]
    },
    {
      "parameters": {
        "fromEmail": "noreply@empresa.com",
        "toEmail": "=admin@empresa.com,{{ $('Extraer').item.json.user }}@empresa.com",
        "subject": "=[ALERTA] Descarga sospechosa: {{ $('Extraer').item.json.filename }}",
        "emailFormat": "html",
        "html": "=<h2>Descarga potencialmente maliciosa</h2><ul><li><strong>Host:</strong> {{ $('Extraer').item.json.hostname }}</li><li><strong>Usuario:</strong> {{ $('Extraer').item.json.user }}</li><li><strong>Archivo:</strong> {{ $('Extraer').item.json.filename }}</li><li><strong>Ruta:</strong> {{ $('Extraer').item.json.path }}</li><li><strong>SHA256:</strong> {{ $('Extraer').item.json.hash }}</li><li><strong>VT detecciones:</strong> {{ $json.data.attributes.last_analysis_stats.malicious }}</li></ul><p>No ejecute el archivo. Reporte a soporte IT.</p>",
        "options": {}
      },
      "id": "e6666666-6666-6666-6666-666666666666",
      "name": "Email Usuario",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1300, 220],
      "credentials": {
        "smtp": {
          "id": "exchange-smtp",
          "name": "exchange-smtp"
        }
      }
    }
  ],
  "connections": {
    "Webhook FIM": {
      "main": [[{ "node": "Extraer", "type": "main", "index": 0 }]]
    },
    "Extraer": {
      "main": [[{ "node": "Filtrar Extension", "type": "main", "index": 0 }]]
    },
    "Filtrar Extension": {
      "main": [
        [{ "node": "VirusTotal", "type": "main", "index": 0 }],
        []
      ]
    },
    "VirusTotal": {
      "main": [[{ "node": "Sospechoso?", "type": "main", "index": 0 }]]
    },
    "Sospechoso?": {
      "main": [
        [{ "node": "Email Usuario", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
