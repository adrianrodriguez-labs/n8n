{
  "name": "01 - Monitoreo Ping VMs",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "a1111111-1111-1111-1111-111111111111",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "return [\n  { hostname: 'dc01', ip: '192.168.1.10' },\n  { hostname: 'exch01', ip: '192.168.1.20' },\n  { hostname: 'fs01', ip: '192.168.1.30' }\n];"
      },
      "id": "a2222222-2222-2222-2222-222222222222",
      "name": "Lista de VMs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "resource": "command",
        "command": "=ping -c 4 {{ $json.ip }}"
      },
      "id": "a3333333-3333-3333-3333-333333333333",
      "name": "SSH Ping",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [680, 300],
      "credentials": {
        "sshPassword": {
          "id": "ssh-control-node",
          "name": "ssh-control-node"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.exitCode }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a4444444-4444-4444-4444-444444444444",
      "name": "Ping OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "fromEmail": "noreply@empresa.com",
        "toEmail": "admin@empresa.com",
        "subject": "=[ALERTA] Maquina {{ $('Lista de VMs').item.json.hostname }} NO responde",
        "emailFormat": "html",
        "html": "=<h2 style=\"color: red;\">ALERTA DE CONECTIVIDAD</h2>\n<p><strong>Maquina:</strong> {{ $('Lista de VMs').item.json.hostname }}</p>\n<p><strong>IP:</strong> {{ $('Lista de VMs').item.json.ip }}</p>\n<p><strong>Hora:</strong> {{ $now }}</p>\n<p><strong>Accion:</strong> Verificar maquina virtual y conexion de red</p>",
        "options": {}
      },
      "id": "a5555555-5555-5555-5555-555555555555",
      "name": "Email Alerta",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1140, 420],
      "credentials": {
        "smtp": {
          "id": "exchange-smtp",
          "name": "exchange-smtp"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "mode": "list",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "list",
          "value": "machine_status"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "hostname": "={{ $('Lista de VMs').item.json.hostname }}",
            "ip": "={{ $('Lista de VMs').item.json.ip }}",
            "status": "={{ $json.exitCode === 0 ? 'UP' : 'DOWN' }}",
            "checked_at": "={{ $now }}"
          }
        },
        "options": {}
      },
      "id": "a6666666-6666-6666-6666-666666666666",
      "name": "Log Postgres",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1140, 180],
      "credentials": {
        "postgres": {
          "id": "postgres-n8n",
          "name": "postgres-n8n"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Lista de VMs", "type": "main", "index": 0 }]]
    },
    "Lista de VMs": {
      "main": [[{ "node": "SSH Ping", "type": "main", "index": 0 }]]
    },
    "SSH Ping": {
      "main": [[{ "node": "Ping OK?", "type": "main", "index": 0 }]]
    },
    "Ping OK?": {
      "main": [
        [{ "node": "Log Postgres", "type": "main", "index": 0 }],
        [{ "node": "Email Alerta", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
