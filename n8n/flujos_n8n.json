{
  "flujos": [
    {
      "id": 1,
      "nombre": "Monitoreo de Ping a Máquinas Virtuales",
      "descripcion": "Verificar conectividad de máquinas críticas cada 5 minutos",
      "trigger": "Cron: */5 * * * * * (cada 5 minutos)",
      "nodos": [
        {
          "tipo": "Cron",
          "nombre": "Trigger Cron",
          "config": "Intervalo: 5 minutos"
        },
        {
          "tipo": "SSH/PowerShell",
          "nombre": "Ejecutar Ping",
          "config": "Comando: ping -c 4 {{ip}}"
        },
        {
          "tipo": "If",
          "nombre": "Validar Respuesta",
          "config": "Condición: {{exitCode}} == 0"
        },
        {
          "tipo": "Email",
          "nombre": "Enviar Alerta",
          "config": "Si falla: notificar a admin@empresa.com"
        },
        {
          "tipo": "Log",
          "nombre": "Registrar",
          "config": "Guardar en BD: machine_status"
        }
      ],
      "impacto": "Detección inmediata de máquinas caídas",
      "complejidad": "Baja",
      "requisitos": ["n8n", "SSH/PowerShell", "Email"]
    },
    {
      "id": 2,
      "nombre": "Alertas de Creación de Usuarios en AD",
      "descripcion": "Notificar cuando se crea una nueva cuenta de usuario",
      "trigger": "Polling cada 10 minutos o Webhook desde AD",
      "nodos": [
        {
          "tipo": "Cron/Webhook",
          "nombre": "Trigger",
          "config": "Cada 10 minutos o evento real-time"
        },
        {
          "tipo": "PowerShell",
          "nombre": "Consultar Usuarios Nuevos",
          "config": "Get-ADUser -Filter {whenCreated -gt última_consulta}"
        },
        {
          "tipo": "Loop",
          "nombre": "Procesar Cada Usuario",
          "config": "Enriquecer con información del manager"
        },
        {
          "tipo": "Email",
          "nombre": "Notificar",
          "config": "Template HTML con detalles del usuario"
        },
        {
          "tipo": "Database",
          "nombre": "Auditoría",
          "config": "Insertar en tabla: user_creations"
        }
      ],
      "impacto": "Trazabilidad de cuentas nuevas",
      "complejidad": "Media",
      "requisitos": ["AD 2019", "PowerShell", "Email", "BD"]
    },
    {
      "id": 3,
      "nombre": "Detección de Escalación de Privilegios",
      "descripcion": "Alertar cuando se agrega usuario a grupos administrativos",
