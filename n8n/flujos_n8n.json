  "arquitectura": {
    "componentes": {
      "n8n": {
        "rol": "Orquestador central",
        "puerto": 5678,
        "protocolo": "HTTPS",
        "autenticacion": "Usuario/Contraseña + MFA (opcional)"
      },
      "Wazuh": {
        "rol": "SIEM - Recolección de eventos",
        "puerto": 55000,
        "protocolo": "HTTPS",
        "autenticacion": "API Key"
      },
      "AD 2019": {
        "rol": "Directorio de identidades",
        "puerto": "389/636 (LDAP/LDAPS), 3268/3269 (GC)",
        "protocolo": "LDAP/LDAPS",
        "autenticacion": "Credenciales de dominio"
      },
      "Exchange 2019": {
        "rol": "SMTP para notificaciones",
        "puerto": "25, 587 (TLS), 465 (SSL)",
        "protocolo": "SMTP",
        "autenticacion": "Credenciales de cuenta de servicio"
      }
    },
