          "config": "Get-ADGroupMember -Identity {{grupo}}"
        },
        {
          "tipo": "Database",
          "nombre": "Comparar con Snapshot",
          "config": "Detectar miembros nuevos"
        },
        {
          "tipo": "If",
          "nombre": "¿Hay Cambios?",
          "config": "¿Miembros nuevos?"
        },
        {
          "tipo": "Email",
          "nombre": "Alerta Crítica",
          "config": "Notificar cambios de privilegios"
        },
        {
          "tipo": "Ticket",
          "nombre": "Crear Ticket",
          "config": "Para revisión manual si es crítico"
        }
      ],
      "impacto": "Detección de escalación no autorizada",
      "complejidad": "Alta",
      "requisitos": ["AD 2019", "Wazuh", "Email", "Sistema Tickets"]
    },
    {
      "id": 4,
      "nombre": "Detección de Instalación de Software",
      "descripcion": "Alertar sobre intentos de instalar software no autorizado",
      "trigger": "Webhook desde Wazuh (real-time)",
      "nodos": [
        {
          "tipo": "Webhook",
          "nombre": "Recibir Evento Wazuh",
          "config": "Event ID: 11707 o pattern matching"
        },
        {
          "tipo": "Extract",
          "nombre": "Extraer Información",
          "config": "Máquina, Usuario, Software, Hash"
        },
        {
          "tipo": "Database",
          "nombre": "Buscar en Lista Blanca",
          "config": "¿Software está aprobado?"
        },
        {
          "tipo": "If",
          "nombre": "¿No Autorizado?",
          "config": "Si no está en lista blanca"
        },
        {
          "tipo": "HTTP",
          "nombre": "Consultar VirusTotal",
          "config": "API para verificar seguridad"
        },
        {
          "tipo": "If",
          "nombre": "¿Malicioso?",
          "config": "Más de 5 detecciones"
        },
        {
          "tipo": "Email/Alert",
          "nombre": "Notificar",
          "config": "Alerta a admin y usuario"
        },
        {
          "tipo": "Isolation",
          "nombre": "Aislar Máquina",
          "config": "Si crítico: desconectar de red"
        }
      ],
      "impacto": "Prevención de malware",
      "complejidad": "Muy Alta",
      "requisitos": ["Wazuh", "VirusTotal API", "Email", "Firewall/Isolate"]
    },
    {
      "id": 5,
      "nombre": "Alertas de Descargas Sospechosas",
      "descripcion": "Monitorear descargas de archivos ejecutables",
      "trigger": "Webhook desde Wazuh (FIM)",
      "nodos": [
        {
          "tipo": "Webhook",
          "nombre": "Detectar Nuevo Archivo",
          "config": "En C:\\\\Users\\\\*\\\\Downloads"
        },
        {
          "tipo": "Filter",
          "nombre": "Filtrar por Extensión",
          "config": ".exe, .msi, .bat, .ps1, .vbs, .zip"
        },
        {
          "tipo": "Hash",
          "nombre": "Calcular SHA256",
          "config": "Hash del archivo"
        },
        {
          "tipo": "HTTP",
          "nombre": "Consultar VirusTotal",
          "config": "Buscar hash en VirusTotal"
        },
        {
          "tipo": "If",
          "nombre": "Resultado VirusTotal",
          "config": "¿Detecciones > 10?"
        },
        {
          "tipo": "Email",
          "nombre": "Notificar Usuario",
          "config": "Archivo descargado es sospechoso"
        },
        {
          "tipo": "Action",
          "nombre": "Cuarentena (Opcional)",
          "config": "Mover a carpeta de cuarentena"
        }
      ],
      "impacto": "Prevención de malware",
      "complejidad": "Media",
      "requisitos": ["Wazuh FIM", "VirusTotal API", "Email"]
    }
